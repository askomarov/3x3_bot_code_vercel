# Токен Telegram бота (получите у @BotFather)
# Для Vercel заведи ОТДЕЛЬНОГО бота — webhook убьёт polling у основного.
BOT_TOKEN=your_bot_token_here

# URL Mini Apps (HTTPS обязательно)
WEBAPP_URL=https://your-webapp-url.com
WEBAPP_3PTS_URL=https://your-3pts-contest-url.com
WEBAPP_TACTICAL_BOARD_URL=https://your-tactical-board-url.com

# ID администратора (@userinfobot)
ADMIN_ID=

DEBUG=True
LOG_LEVEL=DEBUG

# Локально SQLite; на Vercel игнорируется, нужен Postgres
FORCE_SQLITE=True

# Секрет для заголовка X-Telegram-Bot-Api-Secret-Token
TELEGRAM_WEBHOOK_SECRET=change-me

# Полный URL вебхука (после деплоя)
# WEBHOOK_URL=https://your-project.vercel.app/telegram

# Postgres (обязательно на Vercel). Neon / Supabase DATABASE_URL:
# DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
